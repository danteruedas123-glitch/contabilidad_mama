<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: los datos de la app NO salen del celular ni en copias a la
     nube de Google ni al pasar a otro celular. Las copias las hace la app,
     cifradas, cuando mamá lo pide. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
